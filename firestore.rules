rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
  function signedIn(){ return request.auth != null; }
  function owns(){ return signedIn() && resource.data.userId == request.auth.uid; }
  function createsOwn(){ return signedIn() && request.resource.data.userId == request.auth.uid; }
  match /users/{uid} { allow read,write: if signedIn() && request.auth.uid == uid; }
  match /exercises/{id} { allow read: if signedIn(); allow write: if false; }
  match /routines/{id} { allow create: if createsOwn(); allow read,delete: if owns(); allow update: if owns() && createsOwn(); }
  match /workout_sessions/{id} { allow create: if createsOwn(); allow read,delete: if owns(); allow update: if owns() && createsOwn(); }
  match /user_preferences/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if signedIn() && request.auth.uid == uid && request.resource.data.userId == uid; }
}}

